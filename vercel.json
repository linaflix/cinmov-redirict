{
    "framework": null,
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "https://mega.cinmov.com/api/redirect.php?url=$1"
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, s-maxage=31536000"
                }
            ]
        }
    ]
}