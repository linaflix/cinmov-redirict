{
    "framework": null,
    "redirects": [
        {
            "source": "/",
            "destination": "https://mega.cinmov.com",
            "permanent": true
        },
        {
            "source": "/(.+)",
            "destination": "https://mega.cinmov.com/api/redirect.php?url=$1",
            "permanent": false
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                },
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=3600, s-maxage=86400"
                }
            ]
        }
    ]
}
